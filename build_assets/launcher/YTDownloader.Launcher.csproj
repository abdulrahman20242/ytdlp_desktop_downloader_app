<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>YT Downloader</AssemblyName>
    <RootNamespace>YTDownloader.Launcher</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <LangVersion>7.3</LangVersion>
    <ApplicationIcon>..\build\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Lets the SDK build against .NET Framework reference assemblies without
       Visual Studio installed. The output runs on any Windows 10/11 (4.8 is
       built in), so the launcher needs no runtime or additional files. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>