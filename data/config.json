{
  "version": "1.0",
  "ui": {
    "theme": "dark",
    "language": "ar",
    "window_width": 800,
    "window_height": 600
  },
  "download": {
    "default_dir": "F:/projects/Python Projects/yt-dlp/ytdlp_desktop_downloader_app/downloads",
    "default_quality": "720p",
    "default_mode": "video",
    "concurrent_fragments": 4,
    "retries": 10,
    "merge_output_format": "mp4",
    "embed_thumbnail": false,
    "embed_metadata": true,
    "write_subs": false,
    "sub_langs": "ar,en"
